{
  "codyalves/factory-target-app": {
    "baseBranch": "main",
    "setup": [["pnpm", "install", "--frozen-lockfile"]],
    "gates": {
      "lint": ["pnpm", "lint"],
      "typecheck": ["pnpm", "typecheck"],
      "unit_tests": ["pnpm", "test"],
      "build": ["pnpm", "build"]
    },
    "protectedPaths": [
      ".github/**",
      "package.json",
      "pnpm-lock.yaml",
      "pnpm-workspace.yaml",
      "tsconfig.json",
      "biome.json",
      "vitest.config.*",
      "next.config.*",
      "CLAUDE.md"
    ],
    "riskPaths": {
      "high": [
        "**/migrations/**",
        "**/auth/**",
        "**/*auth*.*",
        "middleware.ts",
        "**/payments/**",
        "**/billing/**",
        ".env*"
      ],
      "medium": ["content/company.json", "lib/company.ts", "app/layout.tsx", "app/api/**"]
    },
    "commandTimeoutMs": 600000
  }
}
