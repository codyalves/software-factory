{
  "name": "software-factory",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/dashboard/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm typecheck && pnpm test",
    "dev:api": "node --watch apps/api/src/server.ts",
    "dev:orchestrator": "node --watch apps/orchestrator/src/main.ts",
    "eval:triage": "node apps/workers/src/eval-triage.ts",
    "dev:dashboard": "pnpm --filter @factory/dashboard dev",
    "seed:demo": "node apps/workers/src/testing/seed-demo.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
