# Copy to .env for docker compose. Never commit .env.
GITHUB_WEBHOOK_SECRET=change-me
# Enables /admin routes (dead-letter queue, replay). At least 32 random characters,
# e.g. `openssl rand -hex 32`. Leave unset to disable them.
ADMIN_TOKEN=
POSTGRES_PASSWORD=factory
MINIO_ROOT_PASSWORD=change-me-too
# Lets workers run triage with Claude. Leave unset to keep triage steps queued.
ANTHROPIC_API_KEY=
# The factory's GitHub App (see docs/github-app.md). Unset: comments wait in the outbox.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
