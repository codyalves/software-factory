# Copy to .env for docker compose. Never commit .env.
GITHUB_WEBHOOK_SECRET=change-me
# Enables /admin routes (dead-letter queue, replay). At least 32 random characters,
# e.g. `openssl rand -hex 32`. Leave unset to disable them.
ADMIN_TOKEN=
POSTGRES_PASSWORD=factory
MINIO_ROOT_PASSWORD=change-me-too
